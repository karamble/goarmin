# Every request to the registry carries a regular browser User-Agent, nothing that identifies
# us (keep in sync with pkg/httpx.BrowserUA; a guard test checks it). No audit, fund or
# update-notifier calls.
user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
audit=false
fund=false
update-notifier=false
save-exact=true
