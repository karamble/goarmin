# goarmin's settings inside the container (the compose env_file). Copy this outside the
# repository, e.g. to ~/.config/goarmin/goarmin.env (chmod 600), and fill it in. Never commit
# the real file. Placeholders only.

# The address people open: the reverse proxy's HTTPS URL. Passkeys are bound to its host name
# (the relying party ID) and to its scheme://host:port (the origin); https makes the session
# cookies Secure. Changing it later means adding passkeys again on the new address.
GOARMIN_PUBLIC_URL=https://goarmin.example.internal:8642

# Map tiles (optional; without them routes are drawn on their own): a preset (jawg-matrix,
# jawg-dark) or a URL template with {z}, {x}, {y}. OpenStreetMap's own tile servers are refused.
#GOARMIN_TILE_URL=jawg-matrix
#GOARMIN_TILE_TOKEN=<your access token>

# The largest upload in GB (default 8).
#GOARMIN_IMPORT_MAX_GB=8
