# Variables for docker compose. Copy this outside the repository, e.g. to
# ~/.config/goarmin/compose.env, fill it in, and pass it with --env-file. Placeholders only.

# The image tag; the Makefile and README use `git describe` for it.
GOARMIN_VERSION=local

# Host directories: data (database, raw files, tile cache) and backups. Create them first,
# writable by the user below.
GOARMIN_DATA=/home/you/.local/share/goarmin/data
GOARMIN_BACKUP=/home/you/.local/share/goarmin/backup

# goarmin's own settings (see goarmin.env.example), mode 600.
GOARMIN_ENV_FILE=/home/you/.config/goarmin/goarmin.env

# The user the container runs as: 10001 by default. Under rootless Docker, 0 is the host user
# that runs Docker, so the files stay yours.
GOARMIN_UID=10001
GOARMIN_GID=10001
